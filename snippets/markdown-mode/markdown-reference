# -*- mode: snippet -*-
# name: markdown-reference
# key: markdown
# expand-env: ((yas-indent-line 'fixed) (yas-wrap-around-region 'nil))
# --
---
note:
  id:    ${1: `(let ((filename (file-name-nondirectory (buffer-file-name))))
                (string-match "\\([0-9.a-z]\\{12\\}\\).*" filename)
                (match-string 1 filename))`}
  title: ${2: `(let ((filename (file-name-nondirectory (buffer-file-name))))
           (string-match "[0-9.a-z]\\{12\\} \\(.*\\).md" filename)
           (match-string 1 filename))`}
  tags:   #new #reference
  type:   note
reference:
  author:
  title:
  publisher:
  published:
  type:
  url:
  owned:
  path:
  progress:
  started:
  finished:
---
